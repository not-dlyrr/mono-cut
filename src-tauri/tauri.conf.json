{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mono Cut", "version": "0.1.0", "identifier": "org.monocut.editor",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"title":"Mono Cut","width":1440,"height":940,"minWidth":1040,"minHeight":700,"backgroundColor":"#141416","dragDropEnabled":true,"decorations":false}],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; frame-src 'none'",
      "assetProtocol": {"enable":true,"scope":["**"]}
    }
  },
  "bundle": {
    "active":true,"targets":["nsis"],"category":"Video","shortDescription":"Open-source desktop video editor",
    "resources":["resources/media/*", "resources/notices/*"],
    "icon":["icons/32x32.png","icons/128x128.png","icons/128x128@2x.png","icons/icon.ico","icons/icon.icns"],
    "windows":{"webviewInstallMode":{"type":"skip"},"nsis":{"installMode":"currentUser","displayLanguageSelector":false,"installerIcon":"icons/icon.ico","compression":"zlib"}}
  }
}
